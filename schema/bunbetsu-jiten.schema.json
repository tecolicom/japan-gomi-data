{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tecolicom/japan-gomi-data/schema/bunbetsu-jiten.schema.json",
  "title": "品目辞典 (bunbetsu-jiten.yaml)",
  "description": "自治体が公開する「ごみ分別事典」の品目一覧。品目名から出し方を引くための辞典で、収集日程 (course-*.yaml) とは別の資料。category の値は schema/categories.yaml (収集種別) か schema/disposal.yaml (処分可否) のいずれかに属していなければならない — その検査は scripts/validate.mjs が行う。",
  "type": "object",
  "required": ["source", "items"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": ["extracted_at"],
      "additionalProperties": false,
      "properties": {
        "pdf_url": { "type": "string", "format": "uri" },
        "source_url": { "type": "string", "format": "uri" },
        "extracted_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "pages": { "type": "string" },
        "edition": { "type": "string", "description": "資料そのものの版 (例: 令和8年4月修正)。収録期間とは無関係" },
        "license": { "type": "string", "description": "この辞典の利用条件。リポジトリ全体の CC BY 4.0 と異なる場合は必ず書く" },
        "license_note": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "category"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "reading_initial": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "price": { "type": ["integer", "null"], "minimum": 0 },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
