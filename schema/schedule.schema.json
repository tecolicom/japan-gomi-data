{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tecolicom/japan-gomi-data/main/schema/schedule.schema.json",
  "title": "ごみ収集コース日程",
  "type": "object",
  "required": [
    "metadata",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "city",
        "course",
        "period",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "course": {
          "type": "string",
          "minLength": 1
        },
        "course_name_ja": {
          "type": "string"
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "yomi": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "machiaza_id": {
                "description": "アドレス・ベース・レジストリの町字ID (lg_code6桁-machiaza_id7桁)。area が複数町字をまとめる場合は配列で複数持つ。単一値(文字列)も後方互換で許容。町字レベルの正規キー",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{6}-[0-9]{7}$"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{6}-[0-9]{7}$"
                    }
                  }
                ]
              }
            }
          }
        },
        "period": {
          "description": "収録期間 YYYY-MM--YYYY-MM (月単位の閉区間)。格納ディレクトリ名と一致させる。一次ソースが裏付ける範囲そのもので、会計年度を仮定しない (4月起点・10月起点・暦年・半期がいずれも表せる)。この範囲外の日付は展開しない",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}--\\d{4}-\\d{2}$"
        },
        "source": {
          "type": "object",
          "required": [
            "extracted_at"
          ],
          "additionalProperties": false,
          "properties": {
            "pdf_url": {
              "type": "string",
              "format": "uri"
            },
            "cover_pdf_url": {
              "type": "string",
              "format": "uri"
            },
            "source_url": {
              "type": "string",
              "format": "uri"
            },
            "extracted_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "edition_ja": {
              "description": "自治体自身が刊行物を呼ぶ名称 (例「令和8年度版」)。period とは一致しないことがあるため期間の説明には使わない (例: 東村山市は 2025-10--2026-09 のカレンダーを「令和7年度版」と呼ぶ)",
              "type": "string"
            },
            "extracted_by": {
              "type": "string"
            },
            "verified_by": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "category",
          "pattern"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "enum": [
              "weekly",
              "monthly_nth",
              "monthly_specific"
            ]
          },
          "days": {
            "type": "array",
            "items": {
              "enum": [
                "MO",
                "TU",
                "WE",
                "TH",
                "FR",
                "SA",
                "SU"
              ]
            }
          },
          "occurrences": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "cancelled": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "unknown_periods": {
      "description": "収集の有無が一次ソースから確定できない区間 (period 内側の穴)。「収集なし」ではなく「不明」を表す。cancelled を書かないと『収集あり』の断定になってしまうため、断定も推測もせずに欠落を記録するための宣言。展開時はこの区間の収集日を生成しない",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reason": {
            "description": "なぜ不明なのか。一次ソースの記述を引くこと (例: 市は『年末年始を除く』と明記するが休止の実日付は毎年12月に別途告知)",
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
